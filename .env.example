# ==========================================
# PVC Card Pro - Production Environment File
# ==========================================

# SERVER SETTINGS
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
# The public URL of the application (used for Stripe webhooks and redirects)
BASE_URL=https://your-production-domain.com

# SECURITY & AUTHENTICATION
# Generate a secure 32-byte hex string (e.g., using `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# DATABASE SETTINGS
# SQLite (Default) or PostgreSQL URL
DATABASE_URL=sqlite:///./sql_app.db

# STRIPE LIVE CONFIGURATION
# Replace with your Stripe LIVE Publishable and Secret Keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
# Stripe Webhook Secret (obtained after setting up webhook in Stripe Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# GOOGLE OAUTH 2.0 (Google Sign-In)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: explicitly set redirect URI (defaults to {BASE_URL}/auth/google/callback)
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# FILE CLEANUP SETTINGS
# Minutes before temporary generated files are deleted
FILE_RETENTION_MINUTES=15
